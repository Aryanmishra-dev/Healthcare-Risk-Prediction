{
  "name": "healthcare-risk-prediction-frontend",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "lint": "echo \"HTMX/Jinja frontend is linted through backend template checks\"",
    "build:css": "npx tailwindcss -i ./src/styles/tailwind.css -o ./src/assets/tailwind.css --minify",
