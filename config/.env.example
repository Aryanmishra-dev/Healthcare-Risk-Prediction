# Application
APP_ENV=development
LOG_LEVEL=INFO
API_KEY=replace-with-development-api-key
HOST=127.0.0.1
PORT=8000
ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
TRUSTED_HOSTS=localhost,127.0.0.1
RATE_LIMIT_PER_MINUTE=60

# Database and cache
DATABASE_URL=sqlite:///data/interim/audit_log.db
REDIS_URL=redis://localhost:6379/0

# Model and artifact paths
MODEL_DIR=ml/models
DIABETES_MODEL_PATH=ml/models/diabetes_xgboost.pkl
HEART_DISEASE_MODEL_PATH=ml/models/heart_disease_xgboost.pkl
LUNG_CANCER_MODEL_PATH=ml/models/lung_cancer_model.pkl
SHAP_EXPLAINER_PATH=ml/models/shap_explainer.pkl

# MLOps
MLFLOW_TRACKING_URI=file://mlruns
DVC_REMOTE_NAME=origin

# Cloud storage for model artifacts
S3_MODEL_BUCKET=replace-with-s3-bucket-name
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=replace-with-access-key-id
AWS_SECRET_ACCESS_KEY=replace-with-secret-access-key

# Optional external APIs
OPENAI_API_KEY=replace-with-openai-api-key
