# Frontend (Vercel)
# Public base URL for the Render backend. Used by frontend/scripts/build.mjs.
VITE_API_URL=https://your-render-service.onrender.com

# Backend runtime
# Runtime environment. Use production on Render.
APP_ENV=development

# Python logging level.
LOG_LEVEL=INFO

# Local host and port for uvicorn or local scripts.
HOST=127.0.0.1
PORT=8000

# Prevent Python stdout buffering in container logs.
PYTHONUNBUFFERED=1

# API key required by protected /api/v1 routes in production.
API_KEY=replace-with-production-api-key

# Development fallback API key for non-production when API_KEY is unset.
DEV_API_KEY=your_dev_api_key_here

# Preferred JWT signing secret for auth tokens.
JWT_SECRET_KEY=replace-with-32-plus-character-secret

# Legacy alias also accepted by config/settings.py.
# SECRET_KEY=replace-with-32-plus-character-secret

# Preferred JWT signing algorithm.
JWT_ALGORITHM=HS256

# Legacy alias also accepted by config/settings.py.
# ALGORITHM=HS256

# Access and refresh token lifetimes.
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Comma-separated browser origins allowed to call the backend.
# Include your Vercel production URL and any preview domains you want to allow.
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8000,http://127.0.0.1:8000,https://your-vercel-app.vercel.app

# Legacy CORS alias. ALLOWED_ORIGINS takes precedence when set.
CORS_ORIGINS=http://localhost:3000,http://localhost:8000,http://127.0.0.1:8000,https://your-vercel-app.vercel.app

# Comma-separated Host headers accepted by TrustedHostMiddleware.
TRUSTED_HOSTS=localhost,127.0.0.1,testserver,your-render-service.onrender.com

# App-level rate limit per minute.
RATE_LIMIT_PER_MINUTE=60

# Storage
# Primary database URL used by settings and deployment.
DATABASE_URL=sqlite:///data/interim/audit_log.db

# Synchronous database URL for code paths that need sync database access.
SYNC_DATABASE_URL=sqlite:///data/interim/audit_log.db

# SQLite audit log path.
AUDIT_DB_PATH=data/interim/audit_log.db

# SQLite auth database path. Defaults to AUDIT_DB_PATH when unset.
AUTH_DB_PATH=data/interim/audit_log.db

# Redis URL retained for settings compatibility and deployments that enable Redis.
REDIS_URL=redis://localhost:6379/0

# Models and MLOps
# Directory containing local model artifacts.
MODEL_DIR=ml/models

# local loads bundled artifacts; mlflow tries MLflow first and falls back to disk.
MODEL_SOURCE=local

# MLflow tracking server or local file store.
MLFLOW_TRACKING_URI=file://mlruns

# DVC remote name used by ML workflows.
DVC_REMOTE_NAME=origin

# Optional cloud model storage
# S3 bucket for model artifacts, if using the upload helper or cloud sync.
S3_MODEL_BUCKET=replace-with-s3-bucket-name

# AWS region and credentials for S3 model storage.
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=replace-with-access-key-id
AWS_SECRET_ACCESS_KEY=replace-with-secret-access-key

# Optional external APIs
# OpenAI API key for any optional assistant or NLP integrations that use OpenAI.
OPENAI_API_KEY=replace-with-openai-api-key
