# Backend runtime
APP_ENV=development
LOG_LEVEL=INFO
HOST=127.0.0.1
PORT=8000
PYTHONUNBUFFERED=1

# API and auth
API_KEY=replace-with-production-api-key
DEV_API_KEY=your_dev_api_key_here
JWT_SECRET_KEY=replace-with-32-plus-character-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS and trusted hosts
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8000,http://127.0.0.1:8000,https://your-vercel-app.vercel.app
CORS_ORIGINS=http://localhost:3000,http://localhost:8000,http://127.0.0.1:8000,https://your-vercel-app.vercel.app
TRUSTED_HOSTS=localhost,127.0.0.1,testserver,your-render-service.onrender.com

# Rate limiting
RATE_LIMIT_PER_MINUTE=60

# Storage
DATABASE_URL=postgresql+asyncpg://admin:healthpredict_db_password@localhost:5432/healthcare_audit
SYNC_DATABASE_URL=postgresql://admin:healthpredict_db_password@localhost:5432/healthcare_audit
# AUDIT_DB_PATH and AUTH_DB_PATH removed as they were for SQLite
REDIS_URL=redis://localhost:6379/0

# Models and MLOps
MODEL_DIR=ml/models
MODEL_SOURCE=local
MLFLOW_TRACKING_URI=file://mlruns
DVC_REMOTE_NAME=origin
