images/

# Requirements (dev not needed)
backend/requirements-dev.txt
requirements-dev.txt

# Docker files (avoid recursive includes)
deployment/docker/
docker-compose.yml
Dockerfile
.dockerignore

# Runtime databases
*.db
*.sqlite3
healthcare.db

# Infrastructure/docs/cicd
docs/
monitoring/
scripts/

