[core]
    # Default remote storage for DVC-tracked files.
    # Configure your own remote:
    #   dvc remote add -d myremote s3://bucket/path
    #   dvc remote add -d myremote gs://bucket/path
    #   dvc remote add -d myremote /local/path
    autostage = true

# Example remotes (uncomment and configure one):
# ['remote "s3storage"']
#     url = s3://your-bucket/healthcare-models
# ['remote "gcs"']
#     url = gs://your-bucket/healthcare-models
# ['remote "local"']
#     url = /tmp/dvc-storage
